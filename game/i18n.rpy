# Traducciones de la interfaz navegable (id 10 - i18n).
# El idioma original del juego es el español; este bloque cubre la
# navegación ("Ren'Py change_language") con inglés. Los siguientes pasos
# del i18n envolverán más pantallas siguiendo este mismo patrón:
#   1. Envolver la cadena con _(...) en su pantalla.
#   2. Añadir its coppia old/new aquí.
# El contenido generado por el usuario (títulos de tareas, mensajes de
# la Guía, nombres de listas) permanece en el idioma en que se escribió.

translate english strings:

    # --- Drawer y navigation ---
    old "Mis tareas"
    new "My tasks"

    old "Nueva tarea"
    new "New task"

    old "Mis listas"
    new "My lists"

    old "Calendario"
    new "Calendar"

    old "Mi base"
    new "My base"

    old "Mis logros"
    new "My achievements"

    old "Expediciones"
    new "Expeditions"

    old "Cambiar mundo"
    new "Change world"

    old "Opciones"
    new "Settings"

    old "Ayuda"
    new "Help"

    old "Cerrar menú"
    new "Close menu"

    old "Volver"
    new "Back"

    old "Menú"
    new "Menu"

    # --- Pantalla principal ---
    old "Lista: [current_list] ▾"
    new "List: [current_list] ▾"

    old "Todas"
    new "All"

    old "Hoy"
    new "Today"

    old "Sin fecha"
    new "No date"

    old "Pendientes"
    new "Pending"

    # --- Fase 2: borrar y cerrar serie ---

    old "Eliminar tarea"
    new "Delete task"

    old "¿Borrar esta tarea para siempre?"
    new "Delete this task forever?"

    old "Cerrar serie"
    new "Close series"

    old "¿Cerrar la serie? Solo se borrará esta tarea."
    new "Close the series? Only this task will be deleted."

    old "¿Cerrar la serie? Se borrarán las %d copias de la serie."
    new "Close the series? All %d copies of the series will be deleted."

    # --- Opciones de primer nivel ---
    old "Silenciar todo"
    new "Mute all"

    old "Mostrar a Guía"
    new "Show guide"

    old "Sonido de recompensa"
    new "Reward sound"

    old "Idioma: Español / English"
    new "Language: Español / English"

    # --- Pantalla de confirmación de Ren'Py ---
    old "Sí"
    new "Yes"

    # --- Fase 5: renombrar pasos ---
    old "Renombrar"
    new "Rename"

    old "Cambiar nombre del paso"
    new "Rename step"

    old "Nombre del paso"
    new "Step name"

    old "Escribe el nombre del paso."
    new "Write a name for the step."

    old "Paso renombrado"
    new "Step renamed"

    # --- Fase 5: notas del plan ---
    old "Notas"
    new "Notes"

    old "Notas (hasta 500 caracteres)"
    new "Notes (up to 500 characters)"

    old "[note_len]/500"
    new "[note_len]/500"

    # --- Fase 5: pomodoro personalizado ---
    old "Pomodoro: valores fuera de rango."
    new "Pomodoro: values out of range."

    old "¡Bloque listo! Descansa %d minutos."
    new "Block done! Take a %d minute break."

    old "¡Descanso terminado! Turno de concentrarse."
    new "Break over! Time to focus."

    old "¡Pomodoro completo! %d bloques."
    new "Pomodoro complete! %d blocks."

    old "Bloque %d de %d · %s"
    new "Block %d of %d · %s"

    old "Trabajo"
    new "Work"

    old "Descanso"
    new "Break"

    old "Concéntrate en un solo paso hasta que suene el descanso."
    new "Focus on one step until the break chime."

    old "Levántate, estira y bebe agua. Vuelve para el siguiente bloque."
