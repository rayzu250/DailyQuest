# Traducciones de la interfaz navegable (id 10 - i18n).
# El idioma original del juego es el español; este bloque cubre la
# navegación ("Ren'Py change_language") con inglés. Los siguientes pasos
# del i18n envolverán más pantallas siguiendo este mismo patrón:
#   1. Envolver la cadena con _(...) en su pantalla.
#   2. Añadir its coppia old/new aquí.
# El contenido generado por el usuario (títulos de tareas, mensajes de
# la Guía, nombres de listas) permanece en el idioma en que se escribió.

translate english strings:

    # --- Drawer y navigation ---
    old "Mis tareas"
    new "My tasks"

    old "Nueva tarea"
    new "New task"

    old "Mis listas"
    new "My lists"

    old "Calendario"
    new "Calendar"

    old "Mis logros"
    new "My achievements"

    old "Expediciones"
    new "Expeditions"

    old "Cambiar mundo"
    new "Change world"

    old "Opciones"
    new "Settings"

    old "Ayuda"
    new "Help"

    old "Cerrar menú"
    new "Close menu"

    old "Volver"
    new "Back"

    old "Menú"
    new "Menu"

    # --- Pantalla principal ---
    old "Lista: [current_list] ▾"
    new "List: [current_list] ▾"

    old "Todas"
    new "All"

    old "Hoy"
    new "Today"

    old "Sin fecha"
    new "No date"

    old "7 días"
    new "7 days"

    # --- Fase 2: borrar y cerrar serie ---

    old "Eliminar tarea"
    new "Delete task"

    old "¿Borrar esta tarea para siempre?"
    new "Delete this task forever?"

    old "Cerrar serie"
    new "Close series"

    old "¿Cerrar la serie? Solo se borrará esta tarea."
    new "Close the series? Only this task will be deleted."

    old "¿Cerrar la serie? Se borrarán las %d copias de la serie."
    new "Close the series? All %d copies of the series will be deleted."

    # --- Opciones de primer nivel ---
    old "Silenciar todo"
    new "Mute all"

    old "Mostrar a Guía"
    new "Show guide"

    old "Sonido de recompensa"
    new "Reward sound"

    old "Idioma: Español / English"
    new "Language: Español / English"

    # --- Pantalla de confirmación de Ren'Py ---
    old "Sí"
    new "Yes"
